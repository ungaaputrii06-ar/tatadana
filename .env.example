# ==============================================================================
# TataDana Environment Variables (.env.local)
# Wajib disiapkan dan jangan hardcode di kode manapun
# ==============================================================================

# Telegram Bot Token (Dikelola juga via Settings Web Dashboard)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz_example

# Base URL Webhook Backend (Dipakai saat memanggil setWebhook Telegram)
WEBHOOK_BASE_URL=https://tatadana.app

# Multi-Provider AI API Keys (Disimpan terenkripsi, dikelola via Admin Dashboard)
GEMINI_API_KEY=AIzaSy_demo_key_gemini
OPENAI_API_KEY=sk-proj_demo_key_openai
DEEPSEEK_API_KEY=sk-deep_demo_key_deepseek

# Supabase Database & Auth Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
SUPABASE_STORAGE_BUCKET=tatadana-reports

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXX
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXX
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXX

# Timezone Default
TZ=Asia/Jakarta
